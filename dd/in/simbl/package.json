    "@nestjs/axios": "0.1.0",
    "@nestjs/cache-manager": "^2.2.1",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/event-emitter": "^1.4.1",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "^6.0.5",
    "@nestjs/typeorm": "^9.0.1",
    "body-parser": "^1.20.2",
    "cache-manager": "5.4.0",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.14.1",
    "form-data": "^4.0.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "5.4.1",
    "jira.js": "^2.10.2",
    "jwt-decode": "^3.1.2",
    "keycloak-connect": "^15.0.2",
    "moment": "^2.29.4",
    "multer": "^1.4.3",
    "multer-s3": "^2.10.0",
    "nest-keycloak-connect": "^1.7.6",
    "pg": "^8.8.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "simple-git": "^3.19.1",
